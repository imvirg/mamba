{
  "name": "solana-mamba",
  "private": true,
  "license": "ISC",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "lint:fix": "prettier \"scripts/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" -w",
    "lint": "prettier \"scripts/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-token": "ts-node scripts/create-token.ts",
    "mint-token": "ts-node scripts/mint-token.ts",
    "create-coin": "ts-node scripts/create-coin.ts",
    "verify-authorities": "ts-node scripts/verify-authorities.ts",
    "launch-status": "ts-node scripts/launch-status.ts",
    "validate:launch": "ts-node scripts/validate-launch-readiness.ts",
    "validate:launch:strict": "STRICT_LAUNCH=1 ts-node scripts/validate-launch-readiness.ts",
    "test": "ts-mocha \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@sqds/multisig": "^2.1.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.14.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
